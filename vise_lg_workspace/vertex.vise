// vertex.vise
#version 1

struct VertexInput {
    in vec3 position;
    in vec2 texcoord;
}

struct VertexOutput {
    out vec2 uv;
}

fn main(input: VertexInput) -> VertexOutput {
    let output: VertexOutput;
    output.uv = input.texcoord;
    
    gl_Position = vec4(input.position, 1.0);
    
    return output;
}