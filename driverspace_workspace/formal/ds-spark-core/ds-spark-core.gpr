project DS_Spark_Core is
   -- Wymuszenie trybu SPARK dla wszystkich plików
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatVa", "-gnatQ");
   
   -- Konfiguracja Bare Metal: brak taskingu, brak wyjątków, brak standardowego IO
   package Compiler is
      for Default_Switches ("Ada") use 
          ("-gnatp",           -- Wyłączenie sprawdzania w runtime (brak OS do zgłaszania błędów)
           "-gnatws",          -- Traktuj ostrzeżenia jako błędy
           "-fno-strict-aliasing");
   end Compiler;

   -- Wymuszenie profilu Ravenscar (lub No_Task) dla bare metal
   package Builder is
        for Switches ("Ada") use ("--RTS=ravenscar-sfp"); -- Lub własny no-os runtime
   end Builder;

   -- Budujemy jako bibliotekę statyczną (.a), którą Rust będzie linkował
   for Library_Name use "ds_spark_core";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
end DS_Spark_Core;