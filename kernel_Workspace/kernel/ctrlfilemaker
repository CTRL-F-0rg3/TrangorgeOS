when missing("curl") {
    install("curl")
}

when os("linux") && !exists("bin") {
    cmd("mkdir -p bin")
}

run "build" {
    step 1: cmd("echo start budowy")
    step 2: cmd("zig build -Doptimize={{toolchain.optimizer}}")
    step 3: cmd("cp zig-out/bin/{{output.name}} {{output.path}}")
}

run "check" needs "build" {
    step 1: cmd("zig build test") & cmd("zig fmt --check src")
    step 2: cmd("echo wszystko ok")
}
